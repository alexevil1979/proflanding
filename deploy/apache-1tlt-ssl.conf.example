# Apache 2.4 — 1tlt.ru (сертификаты уже в /etc/letsencrypt/live/1tlt.ru/)
# DocumentRoot = /ssd/www/proflanding/public
# PHP: sock php8.2-fpm ИЛИ TCP :9000 — оставьте один вариант
#
# Установка:
#   sudo cp deploy/apache-1tlt-ssl.conf.example /etc/apache2/sites-available/1tlt.conf
#   sudo a2enmod ssl rewrite headers proxy proxy_fcgi
#   sudo a2ensite 1tlt.conf
#   sudo apache2ctl configtest && sudo systemctl reload apache2
#
# Проверка файлов серта:
#   ls -la /etc/letsencrypt/live/1tlt.ru/
#   # fullchain.pem  privkey.pem  (symlink на archive)

<VirtualHost *:80>
    ServerName 1tlt.ru
    ServerAlias www.1tlt.ru
    DocumentRoot /ssd/www/proflanding/public

    <Directory /ssd/www/proflanding/public>
        AllowOverride All
        Require all granted
        DirectoryIndex index.php
        Options -Indexes +FollowSymLinks
    </Directory>

    # Редирект всего HTTP → HTTPS
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    ErrorLog ${APACHE_LOG_DIR}/1tlt-error.log
    CustomLog ${APACHE_LOG_DIR}/1tlt-http-access.log combined
</VirtualHost>

<VirtualHost *:443>
    ServerName 1tlt.ru
    ServerAlias www.1tlt.ru
    DocumentRoot /ssd/www/proflanding/public

    <Directory /ssd/www/proflanding/public>
        AllowOverride All
        Require all granted
        DirectoryIndex index.php
        Options -Indexes +FollowSymLinks
    </Directory>

    # PHP-FPM — системный 8.2 (sock). Если у вас :9000 — закомментируйте этот блок
    # и раскомментируйте TCP ниже.
    <FilesMatch "\.php$">
        SetHandler "proxy:unix:/run/php/php8.2-fpm.sock|fcgi://localhost"
    </FilesMatch>

    # PHP-FPM TCP :9000 (php82 из сорцов)
    # <FilesMatch "\.php$">
    #     SetHandler "proxy:fcgi://127.0.0.1:9000"
    # </FilesMatch>

    SSLEngine on
    SSLCertificateFile      /etc/letsencrypt/live/1tlt.ru/fullchain.pem
    SSLCertificateKeyFile   /etc/letsencrypt/live/1tlt.ru/privkey.pem
    Include /etc/letsencrypt/options-ssl-apache.conf

    # если файл есть (как на скрине):
    # SSLOpenSSLConfCmd DHParameters /etc/letsencrypt/ssl-dhparams.pem

    # Опционально: www → apex
    # RewriteEngine On
    # RewriteCond %{HTTP_HOST} ^www\.1tlt\.ru$ [NC]
    # RewriteRule ^ https://1tlt.ru%{REQUEST_URI} [L,R=301]

    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    ErrorLog ${APACHE_LOG_DIR}/1tlt-ssl-error.log
    CustomLog ${APACHE_LOG_DIR}/1tlt-ssl-access.log combined
</VirtualHost>
