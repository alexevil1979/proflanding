# Apache 2.4 — proflanding.1tlt.ru
# DocumentRoot = /ssd/www/proflanding/public
# SSL: certbot --apache -d proflanding.1tlt.ru

<VirtualHost *:80>
    ServerName proflanding.1tlt.ru
    DocumentRoot /ssd/www/proflanding/public

    <Directory /ssd/www/proflanding/public>
        AllowOverride All
        Require all granted
        DirectoryIndex index.php
        Options -Indexes +FollowSymLinks
    </Directory>

    <IfModule mod_deflate.c>
        AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/xml
    </IfModule>

    ErrorLog ${APACHE_LOG_DIR}/proflanding-error.log
    CustomLog ${APACHE_LOG_DIR}/proflanding-access.log combined

    RewriteEngine on
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{SERVER_NAME}%{REQUEST_URI} [END,NE,R=permanent]
</VirtualHost>

# После certbot появится похожий блок :443 с SSLEngine on
# и путями к /etc/letsencrypt/live/proflanding.1tlt.ru/
<VirtualHost *:443>
    ServerName proflanding.1tlt.ru
    DocumentRoot /ssd/www/proflanding/public

    <Directory /ssd/www/proflanding/public>
        AllowOverride All
        Require all granted
        DirectoryIndex index.php
        Options -Indexes +FollowSymLinks
    </Directory>

    <IfModule mod_deflate.c>
        AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/xml
    </IfModule>

    ErrorLog ${APACHE_LOG_DIR}/proflanding-ssl-error.log
    CustomLog ${APACHE_LOG_DIR}/proflanding-ssl-access.log combined

    SSLEngine on
    SSLCertificateFile /etc/letsencrypt/live/proflanding.1tlt.ru/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/proflanding.1tlt.ru/privkey.pem
    Include /etc/letsencrypt/options-ssl-apache.conf
</VirtualHost>
