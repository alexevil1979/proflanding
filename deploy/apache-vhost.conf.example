# Apache 2.4 — bizdevops.site
# PHP 8.2 FPM → proxy:fcgi://127.0.0.1:9000
# DocumentRoot = /ssd/www/proflanding/public
#
# Cloudflare DNS (рекомендуется):
#   A    @     185.82.25.45   Proxied (оранжевое облако) ИЛИ DNS only + Let's Encrypt
#   CNAME www  bizdevops.site  Proxied / DNS only
#
# Сначала HTTP-only, затем:
#   sudo certbot --apache -d bizdevops.site -d www.bizdevops.site

<VirtualHost *:80>
    ServerName bizdevops.site
    ServerAlias www.bizdevops.site
    DocumentRoot /ssd/www/proflanding/public

    <Directory /ssd/www/proflanding/public>
        AllowOverride All
        Require all granted
        DirectoryIndex index.php
        Options -Indexes +FollowSymLinks
    </Directory>

    <FilesMatch "\.php$">
        SetHandler "proxy:fcgi://127.0.0.1:9000"
    </FilesMatch>

    ErrorLog ${APACHE_LOG_DIR}/bizdevops-error.log
    CustomLog ${APACHE_LOG_DIR}/bizdevops-access.log combined
</VirtualHost>
