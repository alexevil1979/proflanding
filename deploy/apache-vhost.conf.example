# Пример VirtualHost для Apache 2.4
# DocumentRoot ОБЯЗАТЕЛЬНО на public/

<VirtualHost *:80>
    ServerName DOMAIN
    ServerAlias www.DOMAIN
    DocumentRoot /ssd/www/proflanding/public

    <Directory /ssd/www/proflanding/public>
        AllowOverride All
        Require all granted
        DirectoryIndex index.php
        Options -Indexes +FollowSymLinks
    </Directory>

    # Gzip
    <IfModule mod_deflate.c>
        AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/xml
    </IfModule>

    ErrorLog ${APACHE_LOG_DIR}/proflanding-error.log
    CustomLog ${APACHE_LOG_DIR}/proflanding-access.log combined

    # После выпуска сертификата Let's Encrypt обычно добавит SSL-vhost сам (certbot --apache)
    RewriteEngine on
    RewriteCond %{SERVER_NAME} =DOMAIN [OR]
    RewriteCond %{SERVER_NAME} =www.DOMAIN
    RewriteRule ^ https://%{SERVER_NAME}%{REQUEST_URI} [END,NE,R=permanent]
</VirtualHost>
